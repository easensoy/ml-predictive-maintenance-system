# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Local data (re-created by `python -m predmaint.data download`)
predictive-maintenance/data/cmapss/

# Training outputs: keep every subset's metrics, calibration and predictions, so the published
# numbers can be audited and the figures rebuilt from a fresh clone, plus the full FD001 run that
# the dashboard and Docker image serve. Model weights of the other subsets stay local.
predictive-maintenance/artifacts/*/*
!predictive-maintenance/artifacts/*/metrics.json
!predictive-maintenance/artifacts/*/manifest.json
!predictive-maintenance/artifacts/*/history.json
!predictive-maintenance/artifacts/*/calibration.json
!predictive-maintenance/artifacts/*/contract.json
!predictive-maintenance/artifacts/*/predictions/
!predictive-maintenance/artifacts/FD001/**

# Misc
*.db
*.log
.DS_Store
Thumbs.db
.env
