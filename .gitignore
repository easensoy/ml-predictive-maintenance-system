# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Local data (re-created by `python -m predmaint.data download`)
predictive-maintenance/data/cmapss/

# Training outputs: keep every subset's result files and predictions, so the README tables can be
# audited and the figures rebuilt from a fresh clone, and the full FD001 run that the dashboard
# and Docker image serve.
predictive-maintenance/artifacts/*/*
!predictive-maintenance/artifacts/*/metrics.json
!predictive-maintenance/artifacts/*/history.json
!predictive-maintenance/artifacts/*/calibration.json
!predictive-maintenance/artifacts/*/contract.json
!predictive-maintenance/artifacts/*/predictions/
predictive-maintenance/artifacts/*/predictions/*
!predictive-maintenance/artifacts/*/predictions/test.csv
!predictive-maintenance/artifacts/*/predictions/holdout.csv
!predictive-maintenance/artifacts/FD001/**

# Misc
*.db
*.log
.DS_Store
Thumbs.db
.env
